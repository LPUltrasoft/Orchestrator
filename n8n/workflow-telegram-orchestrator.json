{
  "name": "Orchestrator · Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [-260, 0],
      "webhookId": "orc-telegram-in",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "👀 Tomado. El equipo está trabajando, te aviso cuando termine.",
        "additionalFields": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Acuse inmediato",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-40, 0],
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8787/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Orc-Token",
              "value": "PEGA-ACA-TU-GATEWAY-TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: String($('Telegram Trigger').item.json.message.chat.id), text: $('Telegram Trigger').item.json.message.text, from_name: $('Telegram Trigger').item.json.message.from.first_name }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Gateway · POST /chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orchestrator-reply",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Webhook · respuesta del agente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 220],
      "webhookId": "orchestrator-reply"
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.chat_id }}",
        "text": "={{ $json.body.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Telegram · enviar resultado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-40, 220],
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Acuse inmediato", "type": "main", "index": 0 }]]
    },
    "Acuse inmediato": {
      "main": [[{ "node": "Gateway · POST /chat", "type": "main", "index": 0 }]]
    },
    "Webhook · respuesta del agente": {
      "main": [[{ "node": "Telegram · enviar resultado", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
