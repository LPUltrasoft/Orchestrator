{
  "id": "OrcEntradaTgIn01",
  "name": "Orchestrator · Entrada (Telegram → gateway)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -460,
        0
      ],
      "webhookId": "orc-telegram-in"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e1000000-0000-4000-8000-000000000002-c1",
              "leftValue": "={{ ($env.ORC_ALLOWED_CHAT_IDS || '').split(',').map(s => s.trim()).includes(String($json.message?.chat?.id)) && typeof $json.message?.text === 'string' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "¿Chat autorizado y con texto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "👀 Tomado. El equipo está trabajando, te aviso cuando termine.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "Acuse inmediato",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -20,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Orc-Token",
              "value": "={{ $env.ORC_GATEWAY_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: String($('Telegram Trigger').item.json.message.chat.id), text: $('Telegram Trigger').item.json.message.text, from_name: $('Telegram Trigger').item.json.message.from.first_name }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "Gateway · POST /chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        -80
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "¿Chat autorizado y con texto?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Chat autorizado y con texto?": {
      "main": [
        [
          {
            "node": "Acuse inmediato",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Acuse inmediato": {
      "main": [
        [
          {
            "node": "Gateway · POST /chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
