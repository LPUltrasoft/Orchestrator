#!/usr/bin/env bash
# Delega una tarea a un sub-agente a través del gateway.
# Uso: orc-delegate <rol> <proyecto> "<instrucción>"
set -euo pipefail

usage() {
  cat <<'EOF'
orc-delegate — delega una tarea a un sub-agente especializado.

USO
  orc-delegate <rol> <proyecto> "<instrucción>"

ROLES
  producto   Requerimientos, reglas de negocio, visión. Escribe los documentos 00 y 01.
  dba        Modelo de datos, DER, DDL, migraciones. Escribe el documento 03.
  nestjs     Arquitectura backend y contratos de API. Escribe los documentos 02 y 04.

ARGUMENTOS
  <proyecto>      Nombre de la carpeta del proyecto en el vault. Entre comillas si
                  tiene espacios. Se crea si no existe.
  "<instrucción>" Tarea autocontenida: el sub-agente no ve tu conversación, así que
                  incluí todo el contexto que necesite.

EJEMPLO
  orc-delegate dba "Sistema de Turnos Medicos" "Disenia el modelo de datos en
  PostgreSQL a partir de los requerimientos del documento 01. Incluí DER en mermaid,
  DDL ejecutable y changelogs de Liquibase."

SALIDA
  JSON con: status, response (el resumen del sub-agente), files_changed (los archivos
  que realmente cambiaron, verificado con git), commit y suspect_no_writes.
  Confiá en files_changed, no en lo que diga response.

NOTAS
  Es bloqueante y puede tardar varios minutos: es normal, esperá.
  Un solo sub-agente por proyecto a la vez; si hay otro trabajando devuelve error 409.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 3 ]]; then
  usage >&2
  exit 64
fi

# Solo el orquestador delega. Un sub-agente que delega dispara otro sub-agente:
# el gateway marca quién invoca cada agy en ORC_CALLER.
if [[ -n "${ORC_CALLER:-}" && "$ORC_CALLER" != "orchestrator" ]]; then
  echo "{\"status\":\"ERROR\",\"error\":\"orc-delegate es solo para el orquestador; vos sos el agente ${ORC_CALLER}. Hacé tu tarea con tus herramientas de archivos.\"}" >&2
  exit 77
fi

ROLE="$1"; PROJECT="$2"; shift 2; INSTRUCTION="$*"
case "$ROLE" in
  producto|dba|nestjs) ;;
  *)
    echo "{\"status\":\"ERROR\",\"error\":\"rol desconocido: ${ROLE}. Válidos: producto, dba, nestjs. orc-delegate solo delega; no ejecuta comandos.\"}" >&2
    exit 64
    ;;
esac
GATEWAY="${ORC_GATEWAY_URL:-http://127.0.0.1:8787}"
TOKEN="${ORC_TOKEN:-}"

if [[ -z "$TOKEN" ]]; then
  echo '{"status":"ERROR","error":"ORC_TOKEN no está en el entorno"}' >&2
  exit 78
fi

PAYLOAD=$(PROJECT="$PROJECT" INSTRUCTION="$INSTRUCTION" python3 -c '
import json, os
print(json.dumps({"project": os.environ["PROJECT"], "instruction": os.environ["INSTRUCTION"]}))
')

# Sin --max-time: un sub-agente puede tardar varios minutos legítimamente.
curl -sS -X POST "$GATEWAY/agents/$ROLE" \
  -H "Content-Type: application/json" \
  -H "X-Orc-Token: $TOKEN" \
  -H "X-Orc-Job: ${ORC_JOB_ID:-}" \
  --data "$PAYLOAD"
