# ── Gateway ───────────────────────────────────────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# Token compartido: n8n lo manda en el header X-Orc-Token. Cambialo.
GATEWAY_TOKEN=cambiame-por-algo-largo-y-random

# ── Obsidian (memoria compartida) ─────────────────────────────────────────
# Si renombrás el vault, este es el unico lugar que hay que tocar.
VAULT_PATH=/home/TU_USUARIO/Obsidian/TU_VAULT
PROJECTS_SUBDIR=Proyectos
# Commit automatico en el vault despues de cada turno de sub-agente.
VAULT_AUTOCOMMIT=true

# ── agy (Antigravity CLI) ─────────────────────────────────────────────────
AGY_BIN=agy
# Modelos por rol. `agy models` lista los disponibles.
MODEL_ORCHESTRATOR=gemini-3.8-flash-high
MODEL_PRODUCTO=gemini-3.8-flash-high
MODEL_DBA=gemini-3.1-pro-high
MODEL_NESTJS=gemini-3.1-pro-high
# Timeout por invocacion de agente, en segundos.
JOB_TIMEOUT=900
# Turnos antes de reciclar la conversacion del orquestador (evita input gigante).
ORCHESTRATOR_MAX_TURNS=25

# ── Alternativa con n8n (ver n8n/README.md) ──────────────────────────────
# Solo si n8n es la puerta de Telegram. Con long polling queda vacío.
N8N_CALLBACK_URL=

# ── Seguridad ─────────────────────────────────────────────────────────────
# chat_id de Telegram autorizados, separados por coma. Vacío = cualquiera.
ALLOWED_CHAT_IDS=tu-chat-id-de-telegram

# ── Telegram (long polling: el gateway habla directo con la Bot API) ─────────
# Token de @BotFather. Sin túnel ni URL pública: el gateway sale a buscar los mensajes.
TELEGRAM_BOT_TOKEN=

# ── Cuota de agy ──────────────────────────────────────────────────────────
# Con este porcentaje restante o menos (95% usado) en la ventana de 5 horas o en la
# semanal, el trabajo se pausa y se retoma solo cuando se renueva.
QUOTA_MIN_REMAINING=5
# Segundos de margen después de la hora de renovación antes de retomar.
QUOTA_RESUME_BUFFER=60

# ── Stitch (diseño de pantallas) ──────────────────────────────────────────
# API key de Stitch → Settings → API Keys. Escribila acá; no la pegues en ningún chat.
STITCH_API_KEY=
STITCH_MODEL=GEMINI_3_8_FLASH
